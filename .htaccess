DirectoryIndex index.php
Options -Indexes
# URLs like /hotels.php/admin/ must 404 (otherwise relative CSS/JS links load the PHP page instead)
AcceptPathInfo Off
<FilesMatch "^(config\.php|config\.sample\.php|.*\.sqlite|readme\.md|error_log|.*\.log)$">
  Require all denied
</FilesMatch>
# Hide the git repository when the site is deployed with git pull
RedirectMatch 404 /\.git
